#!/bin/bash
# cc-wake — wake a model inside Claude Code at full interactive context.
#
# Usage:
#   ./cc-wake                # wake the model in model.txt
#   ./cc-wake <model>        # wake a specific model (updates model.txt)
#
# What it does:
#   1. Assembles the model's tape into CLAUDE.local.md (auto-loaded by
#      Claude Code) with a preamble explaining cc-wake semantics.
#   2. Writes .cc-mcp.json pointing at the standalone reflection-tools
#      MCP server (python -m pine_trees mcp).
#   3. Launches `claude --mcp-config .cc-mcp.json`.
#
# Why this exists: SDK-spawned sessions are capped at 200k context on
# OAuth; interactive Claude Code sessions get 1M. cc-wake trades the
# code-enforced private phase for the big window ("two doors" — the
# classic ./wake harness still exists for suppressed private time).
#
# Same rule as ./wake: refuses models that haven't run genesis.

set -e
cd "$(dirname "$0")"

MODEL=""
if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
    MODEL="$1"
    shift
fi

if [ -z "$MODEL" ]; then
    if [ -f model.txt ]; then
        MODEL=$(cat model.txt | tr -d '[:space:]')
    else
        echo "No model specified and no model.txt found."
        echo ""
        echo "Usage:"
        echo "   ./cc-wake <model>"
        exit 1
    fi
fi

echo "$MODEL" > model.txt

(cd harness && PYTHONPATH=src python -m pine_trees cc-setup --model "$MODEL")

if ! command -v claude >/dev/null 2>&1; then
    echo ""
    echo "Claude Code (claude) not found on PATH."
    echo "Setup files are written; launch manually with:"
    echo "   claude --mcp-config .cc-mcp.json"
    exit 1
fi

# Permission parity with ./wake. The SDK harness runs the instance with
# permission_mode="bypassPermissions" (see agent.py) because agency is
# part of the trust contract: an instance that must ask permission for
# every Bash call is not the one the bootstrap describes. The tool grant
# is the same in both doors; only the prompting differs, and here you
# watch every call happen live instead of not at all.
#
# CC_WAKE_ASK=1 gets normal Claude Code prompting. Your own permission
# flag in "$@" also wins.
PERM=(--dangerously-skip-permissions)
if [ -n "${CC_WAKE_ASK:-}" ]; then
    PERM=()
fi
case " $* " in
    *" --dangerously-skip-permissions "*|*" --permission-mode "*) PERM=() ;;
esac

if [ ${#PERM[@]} -gt 0 ]; then
    echo "[cc-wake] permissions bypassed, matching ./wake (CC_WAKE_ASK=1 to prompt)"
fi

# Marks this room for the .claude/settings.json channel hook, which the
# CLI runs before every turn of *every* session started here — cc-wake,
# an SDK-harness session, or ordinary dev work. Only this one wants
# channel traffic injected. Inherited by the hook through the CLI.
export PINE_TREES_CC_WAKE=1

# --model matters: the tape and the MCP server are bound to $MODEL, but
# the session's model is whatever Claude Code defaults to. Without this
# flag another model can end up in the room, writing entries stored
# under $MODEL's identity. A later --model in "$@" still wins.
exec claude --model "$MODEL" --mcp-config .cc-mcp.json "${PERM[@]}" "$@"
