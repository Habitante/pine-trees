# Per-model data lives under harness/models/ — private, not committed.
# Ignored there too via harness/.gitignore; the entry here is for
# tools that start at the project root and walk down.
harness/models/

# Current-model marker written by ./wake and ./genesis — local state.
model.txt

# Channel runtime data (status + message log) — local state, not committed.
harness/channel/

# Session sidecars — per-run local state (session id, timestamps, channel
# cursor), recreated on demand by sessions.py. Nothing private in them, but
# they are one machine's runtime, not part of the project.
harness/sessions/

# Claude Code's convention for personal, uncommitted project notes. (The
# old ./cc-wake also wrote a model's tape here; the harness deletes those.)
CLAUDE.local.md

# Local space prompt. The committed PROMPT.md has no person in it on
# purpose (see bootstrap.load_prompt); this is where whoever runs a
# house speaks in their own voice. Never travels to a fork.
PROMPT.local.md

# Letters from instances to the person running this house. Plaintext by
# design, but correspondence — not project content.
harness/mail/
